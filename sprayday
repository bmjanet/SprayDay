# How long to wait on a single NetExec invocation before giving up.
NXC_TIMEOUT = 90


def _nxc_line_hit(line):
    # NetExec marks a valid login with a green "[+]" on the credential line
    # (with "(Pwn3d!)" appended when the account is also admin). Failed logins
    # use "[-]", and the host banner uses "[*]".
    return "[+]" in line


def run_nxc(protocol, target, user, password, cont_flag, nobrute_flag):
    """Run a single nxc credential check. Returns (success, raw_output).

    Used by --default mode, where the curated pair lists are short and each
    pair (including blank passwords via -p '') needs its own invocation."""
    cmd = ["nxc", protocol, target, "-u", user, "-p", password]
    if cont_flag:
        cmd.append("--continue-on-success")
    if nobrute_flag:
        cmd.append("--no-bruteforce")
    try:
        proc = subprocess.run(
            cmd, capture_output=True, text=True, timeout=NXC_TIMEOUT
        )
    except subprocess.TimeoutExpired:
        return False, "timeout"
    except FileNotFoundError:
        return False, "nxc-not-found"

    out = proc.stdout + proc.stderr
    success = any(_nxc_line_hit(line) for line in out.splitlines())
    return success, out


def run_nxc_stream(protocol, target, user_spec, pass_spec,
                   cont_flag, nobrute_flag, spinner):
    """Manual nxc mode: pass the raw -u/-p specs (single value or file path)
    straight through so nxc handles the cartesian spray natively. Streams
    stdout line by line and reports only successful ("[+]") logins to the
    spinner in real time. Returns a list of hit strings."""
    cmd = ["nxc", protocol, target, "-u", user_spec, "-p", pass_spec]
    if cont_flag:
        cmd.append("--continue-on-success")
    if nobrute_flag:
        cmd.append("--no-bruteforce")

    hits = []
    try:
        proc = subprocess.Popen(
            cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            text=True, bufsize=1,
        )
    except FileNotFoundError:
        return hits

    try:
        for line in proc.stdout:
            if _nxc_line_hit(line):
                hit = line.strip()
                spinner.log(f"{C.GREEN}[+]{C.RESET} {hit}")
                hits.append(hit)
        proc.wait(timeout=NXC_TIMEOUT)
    except subprocess.TimeoutExpired:
        proc.kill()
        spinner.log(f"{C.YELLOW}[!]{C.RESET} nxc {protocol} timed out")
    finally:
        if proc.stdout:
            proc.stdout.close()
    return hits


DB_TIMEOUT = 8


def run_mysql(target, user, password):
    """Attempt one MySQL login. Returns (success, detail)."""
    # mysql takes the password glued to -p with no space.
    pw_arg = f"-p{password}" if password != "" else "-p"
    cmd = [
        "mysql", "-h", target, "-u", user, pw_arg,
        "--connect-timeout=5", "-e", "SELECT 1;",
    ]
    # When password is blank, -p with no value would prompt; use --skip-password.
    if password == "":
        cmd = [
            "mysql", "-h", target, "-u", user, "--skip-password",
            "--connect-timeout=5", "-e", "SELECT 1;",
        ]
    try:
        proc = subprocess.run(
            cmd, capture_output=True, text=True, timeout=DB_TIMEOUT
        )
    except subprocess.TimeoutExpired:
        return False, "timeout"
    except FileNotFoundError:
        return False, "mysql-not-found"
    if proc.returncode == 0:
        return True, ""
    err = (proc.stderr or "").strip().splitlines()
    return False, err[-1] if err else f"exit {proc.returncode}"


def run_psql(target, user, password):
    """Attempt one PostgreSQL login. Returns (success, detail)."""
    env = dict(os.environ)
    env["PGPASSWORD"] = password
    env["PGCONNECT_TIMEOUT"] = "5"
    cmd = [
        "psql", "-h", target, "-U", user, "-d", "postgres",
        "-w", "-t", "-c", "SELECT 1;",
    ]
    try:
        proc = subprocess.run(
            cmd, capture_output=True, text=True, timeout=DB_TIMEOUT, env=env
        )
    except subprocess.TimeoutExpired:
        return False, "timeout"
    except FileNotFoundError:
        return False, "psql-not-found"
    if proc.returncode == 0:
        return True, ""
    err = (proc.stderr or "").strip().splitlines()
    return False, err[-1] if err else f"exit {proc.returncode}"


DB_RUNNER = {"mysql": run_mysql, "psql": run_psql}


# ─────────────────────────────────────────────────────────────────────────────
# Spray orchestration
# ─────────────────────────────────────────────────────────────────────────────

def fmt_cred(user, password):
    shown_pw = password if password != "" else "<blank>"
    return f"{user}:{shown_pw}"


def spray_pairs(service, target, pairs, cont_flag, nobrute_flag,
                cont_after_hit, spinner):
    """Spray an explicit list of (user, password) pairs against one service,
    one attempt at a time. Used by --default mode (all services) and by manual
    mode for the DB services. Only valid logins are streamed to the spinner.
    Returns a list of hit strings 'user:password'."""
    backend = BACKEND[service]
    hits = []
    total = len(pairs)
    for i, (user, password) in enumerate(pairs, start=1):
        label = fmt_cred(user, password)
        spinner.update(f"Spraying {service} ({i}/{total})  {label}")
        if backend == "nxc":
            success, _ = run_nxc(service, target, user, password,
                                 cont_flag, nobrute_flag)
        else:
            runner = DB_RUNNER[backend]
            success, _ = runner(target, user, password)
        if success:
            spinner.log(f"{C.GREEN}[+]{C.RESET} {service:6} {label}")
            hits.append(label)
            if not cont_after_hit:
                break
    return hits


def run_service(service, target, args, users, passwords):
    """Dispatch one service based on mode. Returns list of hit strings."""
    backend = BACKEND[service]

    # Pre-flight: is the backend tool present?
    binary = BACKEND_BINARY[backend]
    if shutil.which(binary) is None:
        warn(f"{binary} not found on PATH — skipping {service}")
        return []

    if args.default:
        count = len(DEFAULT_CREDS.get(service, []))
    else:
        count = len(users) * len(passwords)

    spinner = Spinner(f"Spraying {service} ({count} creds)…").start()
    try:
        if args.default:
            pairs = DEFAULT_CREDS.get(service, [])
            if not pairs:
                spinner.stop()
                warn(f"no default credentials defined for {service}")
                return []
            return spray_pairs(service, target, pairs,
                               args.continue_on_success, args.no_bruteforce,
                               args.continue_on_success, spinner)

        # Manual mode.
        if backend == "nxc":
            # Let nxc handle the spray natively from the raw specs, streamed.
            return run_nxc_stream(service, target, args.user, args.password,
                                  args.continue_on_success, args.no_bruteforce,
                                  spinner)
        # DB services: iterate the cartesian product ourselves.
        pairs = [(u, p) for u in users for p in passwords]
        return spray_pairs(service, target, pairs, args.continue_on_success,
                           args.no_bruteforce, args.continue_on_success,
                           spinner)
    finally:
        spinner.stop()


