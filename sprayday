def valid_ip(value):
    try:
        ipaddress.ip_address(value)
        return True
    except ValueError:
        return False


def load_spec(spec):
    """Resolve a -u/-p value that may be a single value or a file path into a
    list of values. Blank lines in files are dropped; a single value becomes a
    one-item list."""
    if spec is None:
        return []
    if os.path.isfile(spec):
        with open(spec, "r", encoding="utf-8", errors="replace") as fh:
            return [line.rstrip("\n") for line in fh if line.strip()]
    return [spec]


def prompt_ip():
    from InquirerPy import inquirer
    from InquirerPy.validator import ValidationError

    def _validate(result):
        if not valid_ip(result.strip()):
            raise ValidationError(
                message="Enter a valid IPv4/IPv6 address",
                cursor_position=len(result),
            )
        return True

    return inquirer.text(
        message="Target IP address:",
        validate=_validate,
    ).execute().strip()


def prompt_services():
    from InquirerPy import inquirer
    from InquirerPy.base.control import Choice

    choices = [Choice(name, name=name) for name in SERVICE_NAMES]
    selected = inquirer.checkbox(
        message="Select services to spray (space to toggle, enter to confirm):",
        choices=choices,
        validate=lambda r: len(r) >= 1,
        invalid_message="Select at least one service.",
        instruction="",
    ).execute()
    return selected


def require_inquirerpy():
    try:
        import InquirerPy  # noqa: F401
    except ImportError:
        die(
            "InquirerPy is not installed. Install it with:\n"
            "      pip3 install InquirerPy\n"
            "    or run ./install.sh to set up an isolated venv."
        )


