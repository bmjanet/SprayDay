# Main
# ─────────────────────────────────────────────────────────────────────────────

def build_parser():
    p = argparse.ArgumentParser(
        prog="sprayday",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="SprayDay — multi-protocol credential & default-credential "
                    "sprayer for a single target.",
        epilog=(
            "Services: " + ", ".join(SERVICE_NAMES) + "\n\n"
            "Examples:\n"
            "  sprayday 10.10.10.10 -u admin -p 'P@ssw0rd!'\n"
            "  sprayday 10.10.10.10 -u users.txt -p passwords.txt\n"
            "  sprayday 10.10.10.10 --default\n"
            "  sprayday 10.10.10.10 --default --services mysql,pgsql,mssql\n"
            "  sprayday               # prompts for IP and services\n\n"
            "For authorized security testing only."
        ),
    )
    p.add_argument("ip", nargs="?", help="Target IP address (prompted if omitted)")
    p.add_argument("-u", "--user", metavar="USER|FILE",
                   help="Username, or path to a file of usernames (one per line)")
    p.add_argument("-p", "--password", metavar="PASS|FILE",
                   help="Password, or path to a file of passwords (one per line)")
    p.add_argument("--default", action="store_true",
                   help="Spray curated default credentials per selected service "
                        "(ignores -u/-p)")
    p.add_argument("--services", metavar="LIST",
                   help="Comma-separated services to skip the interactive menu, "
                        "e.g. smb,mysql")
    p.add_argument("--continue-on-success", action="store_true",
                   help="Keep spraying a service after a valid credential is found")
    p.add_argument("--no-bruteforce", action="store_true",
                   help="Pass --no-bruteforce to NetExec (safer, one cred at a time)")
    p.add_argument("-o", "--output", metavar="FILE",
                   help="Also append valid credentials to this file")
    p.add_argument("-V", "--version", action="version",
                   version=f"SprayDay v{VERSION}")
    return p


def resolve_services(args):
    if args.services:
        chosen = [s.strip().lower() for s in args.services.split(",") if s.strip()]
        unknown = [s for s in chosen if s not in SERVICE_NAMES]
        if unknown:
            die(f"Unknown service(s): {', '.join(unknown)}. "
                f"Valid: {', '.join(SERVICE_NAMES)}")
        # Preserve canonical run order.
        return [s for s in SERVICE_NAMES if s in chosen]
    require_inquirerpy()
    return [s for s in SERVICE_NAMES if s in set(prompt_services())]


def main():
    args = build_parser().parse_args()

    # Mode validation.
    if args.default and (args.user or args.password):
        die("--default is standalone and cannot be combined with -u/-p")
    if not args.default:
        if not args.user or not args.password:
            die("Manual mode requires both -u and -p (or use --default)")

    # Resolve target IP (arg or prompt).
    target = args.ip
    if not target:
        require_inquirerpy()
        target = prompt_ip()
    if not valid_ip(target):
        die(f"Invalid IP address: {target}")

    # Resolve services (menu or --services).
    services = resolve_services(args)
    if not services:
        die("No services selected")

    # Load credential specs for manual DB iteration.
    users = load_spec(args.user)
    passwords = load_spec(args.password)

    mode = "default credentials" if args.default else "manual (-u/-p)"
    banner(target, services, mode)

    all_hits = []  # list of (service, cred)
    for service in services:
        for cred in run_service(service, target, args, users, passwords):
            all_hits.append((service, cred))
        print()

    # Summary.
    print("=" * 48)
    if all_hits:
        good(f"{len(all_hits)} valid credential(s) found:")
        seen = set()
        for service, cred in all_hits:
            key = (service, cred)
            if key in seen:
                continue
            seen.add(key)
            print(f"    {C.GREEN}{service:6}{C.RESET} {cred}")
        write_log(target, all_hits, args.output)
    else:
        info("No valid credentials found.")
    print("=" * 48)
    good("Spray complete!")


def write_log(target, hits, extra_output):
    ts = datetime.now().strftime("%Y%m%d-%H%M%S")
    default_path = f"sprayday-{target}-{ts}.log"
    paths = [default_path]
    if extra_output:
        paths.append(extra_output)
    seen = set()
    lines = []
    for service, cred in hits:
        key = (service, cred)
        if key in seen:
            continue
        seen.add(key)
        lines.append(f"{ts}\t{target}\t{service}\t{cred}")
    body = "\n".join(lines) + "\n"
    for path in paths:
        try:
            with open(path, "a", encoding="utf-8") as fh:
                fh.write(body)
        except OSError as exc:
            warn(f"could not write log {path}: {exc}")
            continue
    info(f"Valid credentials logged to: {default_path}"
         + (f" and {extra_output}" if extra_output else ""))


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print()
        bad("Interrupted by user")
        sys.exit(130)
