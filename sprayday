class C:
    """ANSI colors, auto-disabled when not writing to a TTY."""
    _on = sys.stdout.isatty()
    RESET = "\033[0m" if _on else ""
    RED = "\033[91m" if _on else ""
    GREEN = "\033[92m" if _on else ""
    YELLOW = "\033[93m" if _on else ""
    BLUE = "\033[94m" if _on else ""
    CYAN = "\033[96m" if _on else ""
    BOLD = "\033[1m" if _on else ""


def info(msg):
    print(f"{C.BLUE}[*]{C.RESET} {msg}")


def good(msg):
    print(f"{C.GREEN}[+]{C.RESET} {msg}")


def bad(msg):
    print(f"{C.RED}[-]{C.RESET} {msg}")


def warn(msg):
    print(f"{C.YELLOW}[!]{C.RESET} {msg}")


def die(msg, code=1):
    bad(msg)
    sys.exit(code)


def banner(target, protocols, mode):
    line = "=" * 48
    print(line)
    print(f"           {C.BOLD}SprayDay v{VERSION}{C.RESET}")
    print("   Multi-Protocol Credential Sprayer")
    print(line)
    info(f"Target    : {target}")
    info(f"Services  : {', '.join(protocols)}")
    info(f"Mode      : {mode}")
    print(line)
    print()


