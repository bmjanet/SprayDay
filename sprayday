class C:
    """ANSI colors, auto-disabled when not writing to a TTY."""
    _on = sys.stdout.isatty()
    RESET = "\033[0m" if _on else ""
    RED = "\033[91m" if _on else ""
    GREEN = "\033[92m" if _on else ""
    YELLOW = "\033[93m" if _on else ""
    BLUE = "\033[94m" if _on else ""
    CYAN = "\033[96m" if _on else ""
    BOLD = "\033[1m" if _on else ""


def info(msg):
    print(f"{C.BLUE}[*]{C.RESET} {msg}")


def good(msg):
    print(f"{C.GREEN}[+]{C.RESET} {msg}")


def bad(msg):
    print(f"{C.RED}[-]{C.RESET} {msg}")


def warn(msg):
    print(f"{C.YELLOW}[!]{C.RESET} {msg}")


def die(msg, code=1):
    bad(msg)
    sys.exit(code)


class Spinner:
    """A pretty background loading indicator.

    Animates a braille spinner on its own thread while the main thread does the
    scanning work. Successful hits are streamed via ``log()``, which clears the
    spinner line, prints a persistent line, and lets the spinner redraw beneath
    it. A shared lock keeps the animation and the streamed lines from
    interleaving. When stdout is not a TTY, animation is disabled and ``log()``
    simply prints (so piped output stays clean).
    """

    FRAMES = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"

    def __init__(self, message):
        self._message = message
        self._lock = threading.Lock()
        self._stop = threading.Event()
        self._thread = None
        self._enabled = sys.stdout.isatty()

    def start(self):
        if self._enabled:
            self._thread = threading.Thread(target=self._spin, daemon=True)
            self._thread.start()
        return self

    def _render(self, frame):
        sys.stdout.write(f"\r\033[K{C.CYAN}{frame}{C.RESET} {self._message}")
        sys.stdout.flush()

    def _spin(self):
        for frame in itertools.cycle(self.FRAMES):
            if self._stop.is_set():
                return
            with self._lock:
                self._render(frame)
            time.sleep(0.1)

    def update(self, message):
        """Change the spinner's message (e.g. progress counter)."""
        with self._lock:
            self._message = message

    def log(self, line):
        """Print a persistent line above the spinner, atomically."""
        with self._lock:
            if self._enabled:
                sys.stdout.write("\r\033[K")
            print(line)
            sys.stdout.flush()

    def stop(self, final=None):
        self._stop.set()
        if self._thread is not None:
            self._thread.join()
            self._thread = None
        if self._enabled:
            sys.stdout.write("\r\033[K")
            sys.stdout.flush()
        if final is not None:
            print(final)


